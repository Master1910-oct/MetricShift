# Metric Shift API Configuration
# NEVER commit secrets to version control

# Supabase Configuration
SUPABASE_URL=https://orpnoxylcdnaxftphanl.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=metricshift-files

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Directory where uploaded files are stored (relative to project root)
UPLOAD_BASE_DIR=uploads

# Directory where per-run pipeline outputs are stored
OUTPUT_BASE_DIR=run_outputs

# Directory containing trained model .pkl files
MODELS_DIR=models
