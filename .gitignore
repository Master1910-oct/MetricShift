# -- Root .gitignore for Metric Shift Monorepo --------------

# -- Dependencies ----------------------------------------------
**/node_modules/
**/.pnp
**/.pnp.js
**/venv/
**/.venv/
**/env/
**/ENV/

# -- Build outputs & caches ------------------------------------
**/dist/
**/dist-ssr/
**/build/
**/.cache/
**/.parcel-cache/
**/*.tsbuildinfo
**/.pytest_cache/
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.coverage
**/htmlcov/

# -- Secrets & Environment variables (NEVER commit secrets) ---
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/*.pem
**/*.key

# -- Runtime outputs & uploads --------------------------------
**/run_outputs/
**/uploads/
**/scratch/
**/outputs/
**/*.log

# -- Local data / Excel workbooks (authoritative source is Supabase) -
**/*.xlsx
**/*.xls
**/*.csv
!care-gap-pipeline/data/sample_*.xlsx

# -- IDE & OS files --------------------------------------------
**/.DS_Store
**/.DS_Store?
**/._*
**/.Spotlight-V100
**/.Trashes
**/ehthumbs.db
**/Thumbs.db
**/Desktop.ini
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
**/.idea/
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?
**/*.swp
**/*.swx
**/*~

# -- Vercel ----------------------------------------------------
**/.vercel/

